# cp .env.example .env e troca as senhas

# InfluxDB (só vale na primeira vez que sobe)
INFLUX_USERNAME=admin
INFLUX_PASSWORD=troque-esta-senha
INFLUX_ORG=cultivia
INFLUX_BUCKET=cultivia
INFLUX_RETENTION=30d
# openssl rand -hex 32
INFLUX_TOKEN=troque-este-token

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-esta-senha

MQTT_TOPIC=cultivia/sensores

# uma senha pra cada cliente do MQTT, sem $ nem aspas (openssl rand -hex 12)
MQTT_ESP32_PASSWORD=troque-esta-senha
MQTT_API_PASSWORD=troque-esta-senha
MQTT_TELEGRAF_PASSWORD=troque-esta-senha
