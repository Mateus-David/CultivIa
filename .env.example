# Copie para .env e ajuste os valores: cp .env.example .env

# InfluxDB (usados só na primeira inicialização do volume)
INFLUX_USERNAME=admin
INFLUX_PASSWORD=troque-esta-senha
INFLUX_ORG=cultivia
INFLUX_BUCKET=cultivia
INFLUX_RETENTION=30d
# Gere com: openssl rand -hex 32
INFLUX_TOKEN=troque-este-token

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-esta-senha

# MQTT
MQTT_TOPIC=cultivia/sensores

# Senhas do MQTT (uma por cliente) e token de login do site/API
# Gere cada uma com: openssl rand -hex 12   (sem $ nem aspas)
MQTT_ESP32_PASSWORD=troque-esta-senha
MQTT_API_PASSWORD=troque-esta-senha
MQTT_TELEGRAF_PASSWORD=troque-esta-senha
API_TOKEN=troque-este-token
