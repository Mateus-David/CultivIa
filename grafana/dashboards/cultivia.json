    {
      "id": 1,
      "type": "gauge",
      "title": "Temperatura",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-cultivia"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-cultivia"
          },
          "query": "from(bucket: \"cultivia\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"estufa\" and r._field == \"temperatura_simulada\")\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 0,
          "max": 40,
          "decimals": 1,
          "displayName": "Temperatura",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 18
              },
              {
