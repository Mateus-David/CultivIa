      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-cultivia"
          },
          "query": "from(bucket: \"cultivia\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"estufa\" and r._field == \"modo\")\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _value: int(v: r._time) / 1000000}))"
        }
